# انسخ هذا الملف إلى .env وعبّئ القيمتين من Supabase → Settings → API
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_PUBLISHABLE_KEY

# ─────────────────────────────────────────────────────────────
# خادم MCP (اختياري — للربط مع كلود)
#
# الرابط والمفتاح يُقرآن من VITE_* أعلاه إن لم تُعرَّف SANAWI_* بديلاً عنهما.
# البريد وكلمة السر هما نفسهما اللذان تدخل بهما التطبيق: الخادم يدخل بحسابك
# فتسري عليه سياسات RLS نفسها ولا يرى إلا ما تراه أنت.
#
# هذه القيم للتشغيل المحلي و`npm run check:mcp` فقط. عند الربط بكلود ضعها في
# قسم env داخل إعداد الخادم لا هنا.
# ─────────────────────────────────────────────────────────────
SANAWI_EMAIL=
SANAWI_PASSWORD=

# 1 = أدوات القراءة وحدها تُسجَّل، فلا يستطيع كلود الكتابة إطلاقاً.
SANAWI_READ_ONLY=0
